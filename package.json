{
  "name": "fullstack-monorepo-template",
  "private": true,
  "version": "0.1.0",
  "description": "Fullstack TypeScript monorepo template: pnpm, Turborepo, NestJS.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "prepare": "husky",
    "rename-scope": "node scripts/rename-scope.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@template/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
